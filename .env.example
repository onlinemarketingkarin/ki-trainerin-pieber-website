# Port (Vorgabe: 3000)
PORT=3000

# Weg A: SQLite-Datei (Vorgabe: data/site.db).
# Liegt das Projekt in iCloud Drive oder Dropbox, die Datei AUSSERHALB ablegen,
# sonst synchronisiert der Dienst die Datenbank mitten im Schreiben.
# SQLITE_FILE=/pfad/ausserhalb/site.db

# Weg B/C: Postgres. Ist DATABASE_URL gesetzt, wird Postgres statt SQLite benutzt.
# DATABASE_URL=postgres://benutzer:passwort@host:5432/datenbank

# Cockpit-Login (ab Stufe 3). Echte Werte nur hier oder beim Hoster, nie ins Repository.
# ADMIN_PASSWORD=

# Generator (ab Stufe 4). Ohne Schlüssel funktioniert alles andere weiter, nur "Neue Seite
# aus Notizen" und "Neu generieren" scheitern mit einer klaren Fehlermeldung.
# ANTHROPIC_API_KEY=

# Optional: Mailversand fürs Kontaktformular (Stufe 3). Ohne SMTP_URL wird die Anfrage
# trotzdem gespeichert, nur die Benachrichtigungs-Mail scheitert (P6).
# SMTP_URL=smtp://benutzer:passwort@smtp.ionos.de:587
